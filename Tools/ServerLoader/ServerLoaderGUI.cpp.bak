        CreateWindowExA(0, "BUTTON", "Give Silvers", WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, gx + 338, 294, 85, 28, hWnd, (HMENU)IDC_GM_GIVE_SIL, nullptr, nullptr);

        // Power Boosts & God Mode
        HWND hPwrGroup = CreateWindowExA(0, "BUTTON", "Power Boosts & Stealth", WS_CHILD | WS_VISIBLE | BS_GROUPBOX,
            gx, 370, 435, 130, hWnd, nullptr, nullptr, nullptr);
        SendMessageA(hPwrGroup, WM_SETFONT, (WPARAM)g_hBoldFont, TRUE);

        CreateWindowExA(0, "BUTTON", "Set Level 140", WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, gx + 15, 395, 125, 28, hWnd, (HMENU)IDC_GM_LVL140, nullptr, nullptr);
        CreateWindowExA(0, "BUTTON", "2nd Rebirth", WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, gx + 150, 395, 125, 28, hWnd, (HMENU)IDC_GM_REBORN2, nullptr, nullptr);
        CreateWindowExA(0, "BUTTON", "Set VIP 6", WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, gx + 285, 395, 135, 28, hWnd, (HMENU)IDC_GM_VIP6, nullptr, nullptr);

        CreateWindowExA(0, "BUTTON", "Toggle God Mode (Invulnerable)", WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, gx + 15, 432, 200, 30, hWnd, (HMENU)IDC_GM_GODMODE, nullptr, nullptr);
        CreateWindowExA(0, "BUTTON", "Toggle Ghost (Invisibility)", WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, gx + 225, 432, 195, 30, hWnd, (HMENU)IDC_GM_INVIS, nullptr, nullptr);

        // Super Gear Spawner
        HWND hItemGroup = CreateWindowExA(0, "BUTTON", "Instant Item Generator", WS_CHILD | WS_VISIBLE | BS_GROUPBOX,
            gx, 510, 435, 95, hWnd, nullptr, nullptr, nullptr);
        SendMessageA(hItemGroup, WM_SETFONT, (WPARAM)g_hBoldFont, TRUE);

        CreateWindowExA(0, "STATIC", "Item ID (e.g. 410309):", WS_CHILD | WS_VISIBLE, gx + 15, 540, 140, 20, hWnd, nullptr, nullptr, nullptr);
        g_hGmItemId = CreateWindowExA(WS_EX_CLIENTEDGE, "EDIT", "410309", WS_CHILD | WS_VISIBLE | ES_NUMBER, gx + 155, 536, 100, 24, hWnd, (HMENU)IDC_GM_ITEM_ID, nullptr, nullptr);
        CreateWindowExA(0, "BUTTON", "Spawn Super +12 Gear", WS_CHILD | WS_VISIBLE | BS_PUSHBUTTON, gx + 265, 534, 155, 28, hWnd, (HMENU)IDC_GM_SPAWN_IT, nullptr, nullptr);
        CreateWindowExA(0, "STATIC", "Tip: In-game you can also type //tc, //givecp 50000, //godmode in chat!", WS_CHILD | WS_VISIBLE, gx + 15, 574, 405, 20, hWnd, nullptr, nullptr, nullptr);

        // Apply Fonts
        SendMessageA(g_hBtnLaunch, WM_SETFONT, (WPARAM)g_hUiFont, TRUE);
        SendMessageA(g_hBtnStop, WM_SETFONT, (WPARAM)g_hUiFont, TRUE);
        SendMessageA(g_hStatus, WM_SETFONT, (WPARAM)g_hUiFont, TRUE);
        SendMessageA(g_hLogEdit, WM_SETFONT, (WPARAM)g_hMonoFont, TRUE);
        SendMessageA(g_hCmdEdit, WM_SETFONT, (WPARAM)g_hMonoFont, TRUE);
        SendMessageA(g_hBtnSend, WM_SETFONT, (WPARAM)g_hUiFont, TRUE);
        SendMessageA(g_hGmName, WM_SETFONT, (WPARAM)g_hUiFont, TRUE);
        SendMessageA(g_hGmMap, WM_SETFONT, (WPARAM)g_hUiFont, TRUE);
        SendMessageA(g_hGmX, WM_SETFONT, (WPARAM)g_hUiFont, TRUE);
        SendMessageA(g_hGmY, WM_SETFONT, (WPARAM)g_hUiFont, TRUE);
        SendMessageA(g_hGmAmount, WM_SETFONT, (WPARAM)g_hUiFont, TRUE);
        SendMessageA(g_hGmItemId, WM_SETFONT, (WPARAM)g_hUiFont, TRUE);

        AppendLog("=========================================================================================\r\n");
        AppendLog("       Conquer Online Master Server Launcher & Hidden GM God Mode Control Panel          \r\n");
        AppendLog("       (Dual Mode: In-App Desktop Buttons + In-Game // Chat Commands Active)             \r\n");
        AppendLog("=========================================================================================\r\n");
        AppendLog("Click [Launch Server] to initialize cluster, or use GM controls on the right panel.\r\n\r\n");
        return 0;
    }

    case WM_COMMAND: {
        int id = LOWORD(wParam);
        if (id == IDC_LAUNCH) {
            std::thread(LaunchCluster).detach();
        } else if (id == IDC_STOP) {
            std::thread(StopCluster).detach();
        } else if (id == IDC_SEND) {
            char buf[512]{};
            GetWindowTextA(g_hCmdEdit, buf, sizeof(buf) - 1);
            if (strlen(buf) > 0) {
                SendCommandToPipe(buf);
                SetWindowTextA(g_hCmdEdit, "");
            }
        }
        // GM Teleport Actions
        else if (id == IDC_GM_TC) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmTeleport(p, 1002, 430, 380, "Twin City", "tc"); }).detach();
        } else if (id == IDC_GM_PC) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmTeleport(p, 1011, 236, 234, "Phoenix Castle", "pc"); }).detach();
        } else if (id == IDC_GM_AC) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmTeleport(p, 1020, 565, 565, "Ape Mountain", "ac"); }).detach();
        } else if (id == IDC_GM_DC) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmTeleport(p, 1000, 500, 650, "Desert City", "dc"); }).detach();
        } else if (id == IDC_GM_BI) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmTeleport(p, 1015, 715, 570, "Bird Island", "bi"); }).detach();
        } else if (id == IDC_GM_MARKET) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmTeleport(p, 1036, 211, 196, "Market", "ma"); }).detach();
        } else if (id == IDC_GM_JAIL) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmTeleport(p, 5000, 50, 50, "NPC Jail", "jail"); }).detach();
        } else if (id == IDC_GM_TP_CUSTOM) {
            char map[16]{}, x[16]{}, y[16]{};
            GetWindowTextA(g_hGmMap, map, sizeof(map) - 1);
            GetWindowTextA(g_hGmX, x, sizeof(x) - 1);
            GetWindowTextA(g_hGmY, y, sizeof(y) - 1);
            int m = atoi(map), px = atoi(x), py = atoi(y);
            if (m > 0 && px > 0 && py > 0) {
                std::string p = GetTargetPlayerName();
                std::thread([p, m, px, py]() { GmTeleport(p, m, px, py, "Custom Coords (" + std::to_string(m) + ")", std::to_string(m) + " " + std::to_string(px) + " " + std::to_string(py)); }).detach();
            } else {
                AppendLog("[GM Warning] Invalid custom map/x/y coordinates.\r\n");
            }
        }
        // GM Economy Actions
        else if (id == IDC_GM_CP_50K) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmGiveCps(p, 50000); }).detach();
        } else if (id == IDC_GM_CP_500K) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmGiveCps(p, 500000); }).detach();
        } else if (id == IDC_GM_SILVER) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmGiveSilvers(p, 100000000); }).detach();
        } else if (id == IDC_GM_GIVE_CP) {
            char amt[32]{};
            GetWindowTextA(g_hGmAmount, amt, sizeof(amt) - 1);
            uint32_t val = (uint32_t)strtoul(amt, nullptr, 10);
            if (val > 0) {
                std::string p = GetTargetPlayerName();
                std::thread([p, val]() { GmGiveCps(p, val); }).detach();
            } else {
                AppendLog("[GM Warning] Enter a valid positive CP amount.\r\n");
            }
        } else if (id == IDC_GM_GIVE_SIL) {
            char amt[32]{};
            GetWindowTextA(g_hGmAmount, amt, sizeof(amt) - 1);
            uint64_t val = (uint64_t)_strtoui64(amt, nullptr, 10);
            if (val > 0) {
                std::string p = GetTargetPlayerName();
                std::thread([p, val]() { GmGiveSilvers(p, val); }).detach();
            } else {
                AppendLog("[GM Warning] Enter a valid positive Silver amount.\r\n");
            }
        }
        // GM Power Boosts
        else if (id == IDC_GM_LVL140) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmSetLevel(p, 140); }).detach();
        } else if (id == IDC_GM_REBORN2) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmSetReborn(p, 2); }).detach();
        } else if (id == IDC_GM_VIP6) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() { GmSetVip(p, 6); }).detach();
        } else if (id == IDC_GM_GODMODE) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() {
                std::string whereClause = BuildWhereClause(p);
                ExecuteGmSql("USE cq1; UPDATE cq_user SET god_status = 1" + whereClause + ";", "Enabled God Mode for " + (p.empty() ? "all players" : p));
            }).detach();
        } else if (id == IDC_GM_INVIS) {
            std::string p = GetTargetPlayerName();
            std::thread([p]() {
                std::string whereClause = BuildWhereClause(p);
                ExecuteGmSql("USE cq1; UPDATE cq_user SET god_status = 2" + whereClause + ";", "Enabled Ghost Invisibility for " + (p.empty() ? "all players" : p));
            }).detach();
        } else if (id == IDC_GM_SPAWN_IT) {
            char item[32]{};
            GetWindowTextA(g_hGmItemId, item, sizeof(item) - 1);
            uint32_t it = (uint32_t)strtoul(item, nullptr, 10);
            if (it == 0) it = 410309; // Default Super Corundum Blade
            std::string p = GetTargetPlayerName();
            std::thread([p, it]() { GmSpawnItem(p, it); }).detach();
        }
        return 0;
    }

    case WM_APPEND_LOG: {
        char* text = (char*)lParam;
        if (text) {
            int len = GetWindowTextLengthA(g_hLogEdit);
            SendMessageA(g_hLogEdit, EM_SETSEL, (WPARAM)len, (LPARAM)len);
            SendMessageA(g_hLogEdit, EM_REPLACESEL, FALSE, (LPARAM)text);
            SendMessageA(g_hLogEdit, WM_VSCROLL, SB_BOTTOM, 0);
            free(text);
        }
        return 0;
    }

    case WM_CTLCOLORSTATIC:
    case WM_CTLCOLOREDIT: {
        HDC hdc = (HDC)wParam;
        HWND hCtrl = (HWND)lParam;
        if (hCtrl == g_hLogEdit || hCtrl == g_hCmdEdit || hCtrl == g_hGmName ||
            hCtrl == g_hGmMap || hCtrl == g_hGmX || hCtrl == g_hGmY ||
            hCtrl == g_hGmAmount || hCtrl == g_hGmItemId) {
            SetTextColor(hdc, RGB(220, 220, 220));
            SetBkColor(hdc, RGB(18, 18, 18));
            return (LRESULT)g_hDarkBrush;
        } else if (hCtrl == g_hStatus) {
            SetTextColor(hdc, RGB(0, 200, 255));
            SetBkColor(hdc, RGB(28, 28, 28));
            return (LRESULT)g_hHeaderBrush;
        } else {
            SetTextColor(hdc, RGB(220, 220, 220));
            SetBkColor(hdc, RGB(28, 28, 28));
            return (LRESULT)g_hHeaderBrush;
        }
    }

    case WM_ERASEBKGND: {
        HDC hdc = (HDC)wParam;
        RECT rc;
        GetClientRect(hWnd, &rc);
        FillRect(hdc, &rc, g_hHeaderBrush);
        return 1;
    }

    case WM_DESTROY: {
        g_bStopThreads = true;
        if (g_hDarkBrush) DeleteObject(g_hDarkBrush);
        if (g_hHeaderBrush) DeleteObject(g_hHeaderBrush);
        if (g_hPanelBrush) DeleteObject(g_hPanelBrush);
        if (g_hMonoFont) DeleteObject(g_hMonoFont);
        if (g_hUiFont) DeleteObject(g_hUiFont);
        if (g_hBoldFont) DeleteObject(g_hBoldFont);
        PostQuitMessage(0);
        return 0;
    }
    }
    return DefWindowProcA(hWnd, msg, wParam, lParam);
}

int APIENTRY WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine, int nCmdShow) {
    WNDCLASSEXA wc{};
    wc.cbSize = sizeof(wc);
    wc.lpfnWndProc = WndProc;
    wc.hInstance = hInstance;
    wc.lpszClassName = "TQServerLoaderWnd";
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);

    if (!RegisterClassExA(&wc)) return 1;

    int screenW = GetSystemMetrics(SM_CXSCREEN);
    int screenH = GetSystemMetrics(SM_CYSCREEN);
    int winW = 1120;
    int winH = 700;
    int x = (screenW - winW) / 2;
    int y = (screenH - winH) / 2;

    g_hWnd = CreateWindowExA(
        0,
        "TQServerLoaderWnd",
        "Conquer Online Master Server Launcher & Hidden GM Control Panel",
        WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX,
        x, y, winW, winH,
        nullptr, nullptr, hInstance, nullptr
    );

    if (!g_hWnd) return 1;

    ShowWindow(g_hWnd, SW_SHOWNORMAL);
    UpdateWindow(g_hWnd);

    MSG msg;
    while (GetMessageA(&msg, nullptr, 0, 0)) {
        if (msg.message == WM_KEYDOWN && msg.wParam == VK_RETURN) {
            HWND focus = GetFocus();
            if (focus == g_hCmdEdit) {
                SendMessageA(g_hWnd, WM_COMMAND, MAKEWPARAM(IDC_SEND, BN_CLICKED), (LPARAM)g_hBtnSend);
                continue;
            }
        }
        TranslateMessage(&msg);
        DispatchMessageA(&msg);
    }

    return (int)msg.wParam;
}
